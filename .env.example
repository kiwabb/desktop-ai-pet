# Desktop standalone-mode (单机模式) defaults, read by the Tauri/Rust process,
# never by the webview. Values saved from the settings page take precedence;
# these only fill fields that were never configured.
# Once saved from the settings page, the API key lives in the OS credential
# store (Keychain / Credential Manager / Secret Service); this env var is only
# a development fallback, never written to disk by the app.
PET_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
PET_AGENT_MODEL_API_KEY=
PET_AGENT_MODEL_NAME=gpt-4o-mini
