# Copy to .env, chmod 600 .env, and provide your own password; no default accounts.
PET_AGENT_POSTGRES_PASSWORD=
PET_AGENT_DATABASE_URL=postgresql://pet_agent:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:15434/pet_agent
PET_AGENT_REDIS_URL=redis://127.0.0.1:16380/0
PET_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
PET_AGENT_MODEL_API_KEY=
PET_AGENT_MODEL_NAME=
PET_AGENT_MODEL_TIMEOUT_SECONDS=90
PET_AGENT_MAX_AGENT_STEPS=8
PET_AGENT_WORKER_CONCURRENCY=2
PET_AGENT_DEFAULT_TIMEZONE=Asia/Shanghai
# Fernet key for encrypted admin-managed model API keys; generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
PET_AGENT_ADMIN_ENCRYPTION_KEY=
PET_AGENT_ADMIN_COOKIE_SECURE=false
PET_AGENT_TRACE_PAYLOAD_RETENTION_DAYS=30
PET_AGENT_TRACE_METADATA_RETENTION_DAYS=90
