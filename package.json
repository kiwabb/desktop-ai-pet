{
  "name": "desktop-ai-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop:build": "tsc -p apps/desktop/tsconfig.json && node apps/desktop/scripts/copy-renderer.mjs",
    "desktop:typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit",
    "desktop:test": "vitest run apps/desktop/src",
    "desktop:run": "pnpm desktop:build && electron apps/desktop/dist/main/main.js",
    "test": "vitest run src",
    "closed:extract": "node tools/extract-closed-reference.mjs",
    "closed:verify": "node tools/verify-closed-reference.mjs",
    "compact:verify": "node tools/verify-component-compact.mjs",
    "pet2d:validate": "node tools/validate-white-cat-2d.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.10.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "45.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.6.0"
}
